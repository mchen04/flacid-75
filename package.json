{
  "name": "my-wellness",
  "version": "4.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run tokens && node scripts/build-client.mjs && next dev",
    "build": "npm run tokens && node scripts/build-client.mjs && next build && node scripts/budget.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run scan && npm run build",
    "budget": "node scripts/budget.mjs",
    "tokens": "node --import tsx scripts/tokens.ts",
    "art": "npm run tokens && node --import tsx scripts/art.tsx",
    "scan": "node scripts/token-scan.mjs && node scripts/mascot-scan.mjs",
    "test:integration": "node --env-file=.env.local --import tsx scripts/integration.ts"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "next": "16.3.4",
    "pg": "^8.16.3",
    "preact": "^10.29.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.4",
    "lighthouse": "^12.8.2",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "undici": "^6.28.1"
  },
  "type": "module"
}
